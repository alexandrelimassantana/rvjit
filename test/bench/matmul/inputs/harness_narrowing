# Outputs narrower than the accumulators: the products accumulate wide and
# the accumulators are narrowed as they are stored (floats round to nearest
# even, integers saturate), the previous C is widened when beta applies, and
# bias and the scalars take the accumulation type. Every type pair over the
# epilogue features, the shape sources, the transposes, M tails and the
# register budget. --kblock is not combined: it rounds C once per call

# f16:f16:f16 accumulating in f32
--reset
--dt=f16:f16:f16 --acc=f32
--scalar=runtime
--post=none,alpha,beta,bias,postop,alpha+beta,beta+bias,alpha+beta+bias+postop
--shape=literal,runtime --transA=0,1 --transB=0,1
3v+1x5x9_n"narrow_f16_features"

--reset
--dt=f16:f16:f16 --acc=f32
--scalar=runtime
--post=none,beta,bias,alpha+beta+bias+postop
--shape=literal,less_eq,runtime --kshape=literal,runtime
--m_max=3v+1 --n_max=7 --k_max=20
3v+1x7x20_n"narrow_f16_sources"

